<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bromhobit.rebox</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/libexec/rebox/rebox-controller</string>
        <string>auto</string>
    </array>
    <key>UserName</key>
    <string>mobile</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/var/mobile/Library/Rebox/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/Rebox/daemon.log</string>
    <key>Disabled</key>
    <false/>
</dict>
</plist>
